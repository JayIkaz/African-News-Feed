# Postgres connection string (Supabase: use the pooled "Transaction" connection
# string for the Vercel API, and the direct connection for migrations/ingestion).
DATABASE_URL=

# Shared secret for POST /api/ingestion/trigger and /api/ingestion/backfill-images.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Resend API key for newsletter welcome emails (optional — subscribe still works
# without it, no email is sent).
RESEND_API_KEY=

# Extra allowed CORS origins, comma-separated (production domains are built in).
# ALLOWED_ORIGINS=

# Long-lived server only (Replit/local): set to 1 to re-enable the in-process
# hourly ingestion scheduler. Production uses .github/workflows/ingest.yml.
# ENABLE_IN_PROCESS_INGESTION=
