# Postgres connection string (Supabase: use the pooled "Transaction" connection
# string for the Vercel API, and the direct connection for migrations/ingestion).
DATABASE_URL=

# Shared secret for POST /api/ingestion/trigger and /api/ingestion/backfill-images.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Newsletter welcome emails. Both values are needed to send one. Subscribing
# still works without them, and no email is sent.
RESEND_API_KEY=

# Signs the unsubscribe link in each email. Without it no email is sent, because
# the email could not be opted out of. Generate with: openssl rand -hex 32
# Changing it later makes unsubscribe links in emails already sent stop working.
NEWSLETTER_SECRET=

# DeepL API key for the English translation of French, Portuguese and Arabic
# stories (optional). Keys ending in ":fx" use DeepL's free API. Without it,
# stories already translated are still served, and a request for a new
# translation gets a 503.
DEEPL_API_KEY=

# Extra allowed CORS origins, comma-separated (production domains are built in).
# ALLOWED_ORIGINS=

# Long-lived server only (Replit/local): set to 1 to re-enable the in-process
# hourly ingestion scheduler. Production uses .github/workflows/ingest.yml.
# ENABLE_IN_PROCESS_INGESTION=
