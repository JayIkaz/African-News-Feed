{
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://african-news-feed-api-server.vercel.app/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://african-news-feed-api-server.vercel.app/api/sitemap.xml"
    },
    {
      "source": "/article/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot|Slackbot|Slack-ImgProxy|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|Mastodon|Embedly|Googlebot|Google-InspectionTool|bingbot|Applebot|DuckDuckBot|YandexBot).*"
        }
      ],
      "destination": "https://african-news-feed-api-server.vercel.app/api/share/article/:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/flags/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
